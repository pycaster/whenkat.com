---
import { getCollection } from 'astro:content';
import SiteLayout from '../../whenkat/layouts/SiteLayout.astro';
import { dateLabel, dateValue } from '../../whenkat/lib/posts';
import { whenkat as site } from '../../whenkat/config';
import '../../whenkat/styles/article-list.css';
const posts = (await getCollection('blog'))
  .map(({ id, data }) => ({ ...data, href: `/blog/${id}/` }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime() || (a.seriesOrder ?? 0) - (b.seriesOrder ?? 0) || a.title.localeCompare(b.title));
---
<SiteLayout title="Articles — Venkat Reddy Marepally" description="Articles on engineering, infrastructure, the homelab, and local AI by Venkat Reddy Marepally." minimal>
  <main class="articles-page" id="main-content" data-article-list data-index="/search-index.json">
    <nav class="articles-nav" aria-label="Main navigation"><a href={site.home}>Home</a><a href={site.about}>About me</a></nav>
    <h1>Articles</h1>
    <div class="articles-layout">
      <aside class="article-filter" aria-label="Filter articles" data-filter-panel hidden>
        <form role="search">
          <label for="article-keyword">Filter articles</label>
          <input id="article-keyword" type="search" name="q" placeholder="Keyword" autocomplete="off" aria-controls="article-items" />
          <button type="button" data-clear hidden>Clear filter</button>
        </form>
      </aside>
      <section class="article-results" aria-label="Published articles">
        <p class="article-count" role="status" aria-live="polite" aria-atomic="true" data-count>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
        <ol class="article-items" id="article-items">
          {posts.map(post => <li data-article data-series={post.series ?? ''}>
            <h2><a href={post.href}>{post.title}</a></h2>
            <p class="article-excerpt">{post.description}</p>
            <p class="article-meta"><time datetime={dateValue(post.pubDate).toISOString()}>{dateLabel(post.pubDate)}</time>{post.series && <span>{post.series}</span>}</p>
          </li>)}
        </ol>
        <p class="article-empty" data-empty hidden>No articles match this keyword. Try another keyword or clear the filter.</p>
        {posts.length === 0 && <p>No articles published yet.</p>}
      </section>
    </div>
  </main>
</SiteLayout>
<script>
  import { mountArticleList } from '../../whenkat/scripts/article-list.js';
  let cleanup: (() => void) | undefined;
  function mount() {
    const root = document.querySelector('[data-article-list]');
    if (root) cleanup = mountArticleList(root) ?? cleanup;
  }
  function dispose() { cleanup?.(); cleanup = undefined; }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', dispose);
  window.addEventListener('pagehide', event => { if (!event.persisted) dispose(); });
</script>
